<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Batch Manufacturing Record: BMR/YYYY/NNNNN -->
    <record id="seq_pharma_bmr" model="ir.sequence">
        <field name="name">Batch Manufacturing Record</field>
        <field name="code">pharma.bmr</field>
        <field name="prefix">BMR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Deviation: DEV/YYYY/NNNNN -->
    <record id="seq_pharma_deviation" model="ir.sequence">
        <field name="name">Pharma Deviation</field>
        <field name="code">pharma.deviation</field>
        <field name="prefix">DEV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- CAPA: CAPA/YYYY/NNNNN -->
    <record id="seq_pharma_capa" model="ir.sequence">
        <field name="name">Pharma CAPA</field>
        <field name="code">pharma.capa</field>
        <field name="prefix">CAPA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- QC Test Order: QC/YYYY/NNNNN -->
    <record id="seq_pharma_qc_order" model="ir.sequence">
        <field name="name">QC Test Order</field>
        <field name="code">pharma.qc.test.order</field>
        <field name="prefix">QC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- QC Specification -->
    <record id="seq_pharma_qc_spec" model="ir.sequence">
        <field name="name">QC Specification</field>
        <field name="code">pharma.qc.spec</field>
        <field name="prefix"></field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- OOS Investigation: OOS/YYYY/NNNNN -->
    <record id="seq_pharma_oos" model="ir.sequence">
        <field name="name">OOS Investigation</field>
        <field name="code">pharma.oos.investigation</field>
        <field name="prefix">OOS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Certificate of Analysis: COA/YYYY/NNNNN -->
    <record id="seq_pharma_coa" model="ir.sequence">
        <field name="name">Certificate of Analysis</field>
        <field name="code">pharma.coa</field>
        <field name="prefix">COA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Vendor Qualification: VQ/YYYY/NNNNN -->
    <record id="seq_pharma_vendor_qual" model="ir.sequence">
        <field name="name">Vendor Qualification</field>
        <field name="code">pharma.vendor.qualification</field>
        <field name="prefix">VQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
