<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lot/Serial number traceability, expiry, and QA status views. -->

    <record id="pharma_quarantine_quant_list" model="ir.ui.view">
        <field name="name">pharma.quarantine.quant.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list string="Quarantine Queue" create="0" delete="0"
                  decoration-warning="lot_id != False">
                <field name="has_incoming_qc" column_invisible="1"/>

                <field name="product_id" readonly="1"/>
                <field name="lot_id" string="Lot / Batch" readonly="1"
                       groups="stock.group_production_lot"/>
                <field name="location_id" readonly="1"/>
                <field name="quantity" string="Qty on Hand" readonly="1"/>
                <field name="reserved_quantity" string="Reserved" readonly="1" optional="show"/>
                <field name="product_uom_id" string="UoM" readonly="1"
                       groups="uom.group_uom"/>
                <!-- lot status badge, loaded via related -->
                <button name="action_quant_create_qc_test" type="object"
                        string="Create Test Order" class="btn-secondary" icon="fa-flask"
                        invisible="has_incoming_qc"/>
                <button name="action_quant_open_lot" type="object"
                        string="Open Lot" class="btn-link" icon="fa-external-link"/>
            </list>
        </field>
    </record>
    <record id="pharma_quarantine_quant_form" model="ir.ui.view">
        <field name="name">pharma.quarantine.quant.form</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <form string="Quarantine Item" create="0" delete="0">
                <header>
                    <button name="action_quant_create_qc_test" type="object" string="Create Test Order" class="oe_highlight" invisible="has_incoming_qc"/>
                </header>
                <sheet>
                    <field name="has_incoming_qc" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Material">
                            <field name="product_id" readonly="1"/>
                            <field name="lot_id" string="Lot / Batch" readonly="1"
                                   groups="stock.group_production_lot"/>
                            <field name="location_id" readonly="1"/>
                        </group>
                        <group string="Quantity">
                            <field name="quantity" string="Qty on Hand" readonly="1"/>
                            <field name="reserved_quantity" string="Reserved" readonly="1"/>
                            <field name="available_quantity" string="Available" readonly="1"/>
                            <field name="product_uom_id" string="UoM" readonly="1"
                                   groups="uom.group_uom"/>
                        </group>
                    </group>
                    <group string="Lot / Batch Details"
                           invisible="not lot_id"
                           groups="stock.group_production_lot">
                        <group>
                            <field name="lot_id" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>GMP Notice:</strong> This material is in <strong>Quarantine</strong>.
                        It must pass incoming QC testing before it can be used in production.
                        Use the buttons above to Approve, Reject, Put On Hold, or create a QC Test Order.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pharma_quarantine_queue_action" model="ir.actions.act_window">
        <field name="name">Quarantine Queue</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lot_id.lot_status', '=', 'quarantine'), ('location_id.usage', '=', 'internal'),
            ('quantity', '>', 0)]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('pharmaceutical_erp.pharma_quarantine_quant_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('pharmaceutical_erp.pharma_quarantine_quant_form')})
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No materials currently in quarantine.
            </p>
            <p>Materials are automatically placed here when a goods receipt is validated.
               Approve them to Stock after incoming QC testing passes.</p>
        </field>
    </record>
    <record id="stock_lot_genealogy_form" model="ir.ui.view">
        <field name="name">stock.lot.genealogy.form</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <form string="Batch Genealogy" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Batch No" readonly="1"/>
                            <field name="product_id" string="Product" readonly="1"/>
                            <field name="produced_production_ids" string="MO" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="bmr_ids" string="BMR" widget="many2many_tags" readonly="1"/>
                            <field name="lot_status" string="Status" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Material Traceability">
                            <field name="consumed_lot_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name" string="RM Lot"/>
                                    <field name="product_id" string="Material"/>
                                    <field name="vendor_ids" string="Vendor" widget="many2many_tags"/>
                                    <field name="purchase_order_ids" string="PO" widget="many2many_tags"/>
                                    <field name="lot_status" string="QC Status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manufacturing">
                            <field name="bmr_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name" string="BMR"/>
                                    <field name="yield_percentage" string="Yield"/>
                                    <field name="status" string="Status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Quality">
                            <group>
                                <group>
                                    <field name="incoming_qc_ids" string="Incoming QC" widget="many2many_tags" readonly="1" placeholder="No Incoming QC..."/>
                                    <field name="ipqc_ids" string="IPQC" widget="many2many_tags" readonly="1" placeholder="No IPQC..."/>
                                    <field name="fg_qc_ids" string="FG QC" widget="many2many_tags" readonly="1" placeholder="No FG QC..."/>
                                </group>
                                <group>
                                    <field name="oos_investigation_ids" string="OOS Investigations" widget="many2many_tags" readonly="1" placeholder="No OOS..."/>
                                    <field name="deviation_ids" string="Deviations" widget="many2many_tags" readonly="1" placeholder="No Deviations..."/>
                                    <field name="capa_ids" string="CAPAs" widget="many2many_tags" readonly="1" placeholder="No CAPAs..."/>
                                    <field name="coa_ids" string="CoAs" widget="many2many_tags" readonly="1" placeholder="No CoAs..."/>
                                </group>
                            </group>
                        </page>
                        <page string="Release">
                            <group>
                                <group>
                                    <field name="status_changed_by" string="Released By" readonly="1"/>
                                    <field name="status_changed_on" string="Release Date" readonly="1"/>
                                    <field name="coa_ids" string="CoA" widget="many2many_tags" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Distribution">
                            <field name="delivery_order_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name" string="Delivery Orders"/>
                                    <field name="partner_id" string="Customers"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                    <field name="customer_ids" string="Customers" widget="many2many_tags" readonly="1"/>
                                    <field name="invoice_ids" string="Invoices" widget="many2many_tags" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pharma_batch_genealogy_action" model="ir.actions.act_window">
        <field name="name">Batch Genealogy</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('stock.view_production_lot_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('pharmaceutical_erp.stock_lot_genealogy_form')})
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No lots found.
            </p>
        </field>
    </record>

</odoo>
