<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="property_type_villa" model="project.property.type">
            <field name="name">Luxury Villa</field>
            <field name="code">VILLA</field>
            <field name="sequence">10</field>
            <field name="description">Standalone luxury villas, estates, and private mansions.</field>
        </record>

        <record id="property_type_penthouse" model="project.property.type">
            <field name="name">Penthouse / Apartment</field>
            <field name="code">APT</field>
            <field name="sequence">20</field>
            <field name="description">High-rise luxury apartments, duplexes, and penthouses.</field>
        </record>

        <record id="property_type_commercial" model="project.property.type">
            <field name="name">Commercial / Corporate Office</field>
            <field name="code">OFFICE</field>
            <field name="sequence">30</field>
            <field name="description">Corporate headquarters, executive office suites, and co-working spaces.</field>
        </record>

        <record id="property_type_hospitality" model="project.property.type">
            <field name="name">Hotel / Restaurant / Hospitality</field>
            <field name="code">HOSP</field>
            <field name="sequence">40</field>
            <field name="description">Boutique hotels, fine dining restaurants, VIP lounges, and resorts.</field>
        </record>

        <record id="property_type_retail" model="project.property.type">
            <field name="name">Retail Showroom</field>
            <field name="code">RETAIL</field>
            <field name="sequence">50</field>
            <field name="description">Luxury retail stores, fashion boutiques, and brand showrooms.</field>
        </record>
    </data>
</odoo>
