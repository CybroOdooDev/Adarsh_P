<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Site Survey List View -->
    <record id="view_project_site_survey_list" model="ir.ui.view">
        <field name="name">project.site.survey.list</field>
        <field name="model">project.site.survey</field>
        <field name="arch" type="xml">
            <list string="Site Surveys" sample="1">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="address"/>
                <field name="scheduled_date"/>
                <field name="survey_date"/>
                <field name="surveyor_id" widget="many2one_avatar_user"/>
                <field name="measurement_count" string="Measurements"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'scheduled'"
                       decoration-primary="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Site Survey Form View -->
    <record id="view_project_site_survey_form" model="ir.ui.view">
        <field name="name">project.site.survey.form</field>
        <field name="model">project.site.survey</field>
        <field name="arch" type="xml">
            <form string="Site Survey">
                <header>
                    <button name="action_schedule" string="Schedule Visit" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Survey" type="object" class="oe_highlight"
                            invisible="state != 'scheduled'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('scheduled', 'completed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Survey Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Customer">
                            <field name="project_id" options="{'no_create_edit': False}"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Survey Details">
                            <field name="scheduled_date" required="state == 'draft'"/>
                            <field name="survey_date"/>
                            <field name="surveyor_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <group string="Site Address">
                        <field name="address" nolabel="1" placeholder="Auto-filled from project, editable here..."/>
                    </group>
                    <notebook>
                        <!-- Tab Named "Measurements" -->
                        <page string="Measurements" name="measurements">
                            <field name="measurement_ids">
                                <list editable="bottom" decoration-muted="not_required">
                                    <field name="sequence" widget="handle"/>
                                    <field name="measure_by" column_invisible="1"/>
                                    <field name="room" placeholder="e.g. Master Bedroom"/>
                                    <field name="name" placeholder="e.g. Wall 1, Window 2, Wardrobe"/>
                                    <field name="description" placeholder="Description / details..." optional="hide"/>
                                    <field name="type_id" options="{'no_create_edit': False}"/>
                                    <field name="length" readonly="measure_by == 'count'"/>
                                    <field name="width" readonly="measure_by != 'area_lw'"/>
                                    <field name="height" readonly="measure_by != 'area_lh'"/>
                                    <field name="count"/>
                                    <field name="quantity" readonly="1" force_save="1"/>
                                    <field name="quantity_unit"/>
                                    <field name="not_required"/>
                                    <field name="not_required_reason" invisible="not not_required" required="not_required" placeholder="Reason for exclusion..."/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Observations" name="notes">
                            <field name="notes" placeholder="Enter site observations, access restrictions, or notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Site Survey Search View -->
    <record id="view_project_site_survey_search" model="ir.ui.view">
        <field name="name">project.site.survey.search</field>
        <field name="model">project.site.survey</field>
        <field name="arch" type="xml">
            <search string="Search Site Surveys">
                <field name="name" string="Reference"/>
                <field name="project_id"/>
                <field name="partner_id" string="Customer"/>
                <field name="surveyor_id"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Visit Scheduled" name="state_scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="In Progress" name="state_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="state_completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="My Surveys" name="my_surveys" domain="[('surveyor_id', '=', uid)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Surveyor" name="group_surveyor" context="{'group_by': 'surveyor_id'}"/>
                    <filter string="Scheduled Date" name="group_scheduled_date" context="{'group_by': 'scheduled_date'}"/>
                    <filter string="Survey Date" name="group_date" context="{'group_by': 'survey_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Site Survey Action -->
    <record id="action_project_site_survey" model="ir.actions.act_window">
        <field name="name">Site Surveys</field>
        <field name="res_model">project.site.survey</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_site_survey_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first Site Survey!
            </p>
            <p>
                Capture on-site room measurements, lengths, widths, heights, and counts directly linked to furnishing projects.
            </p>
        </field>
    </record>

</odoo>
