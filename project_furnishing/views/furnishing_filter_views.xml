<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search view extensions with Furnishing Projects filter -->
    <record id="view_sales_order_filter_furnishing" model="ir.ui.view">
        <field name="name">sale.order.search.furnishing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Furnishing Projects" name="filter_furnishing" domain="[('is_furnishing_project', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_quotation_furnishing" model="ir.ui.view">
        <field name="name">sale.order.search.quotation.furnishing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Furnishing Projects" name="filter_furnishing" domain="[('is_furnishing_project', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_furnishing" model="ir.ui.view">
        <field name="name">purchase.order.search.furnishing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Furnishing Projects" name="filter_furnishing" domain="[('is_furnishing_project', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_furnishing" model="ir.ui.view">
        <field name="name">account.move.search.furnishing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Furnishing Projects" name="filter_furnishing" domain="[('is_furnishing_project', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_furnishing" model="ir.ui.view">
        <field name="name">account.payment.search.furnishing</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Furnishing Projects" name="filter_furnishing" domain="[('is_furnishing_project', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated Window Actions with default furnishing filter and domain -->
    <record id="action_project_furnishing_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="domain">[('is_furnishing_project', '=', True)]</field>
        <field name="context">{'search_default_filter_furnishing': 1, 'search_default_my_quotation': 0, 'default_is_furnishing_project': True}</field>
    </record>

    <record id="action_project_furnishing_sale_orders" model="ir.actions.act_window">
        <field name="name">Sale Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="search_view_id" ref="sale.view_sales_order_filter"/>
        <field name="domain">[('is_furnishing_project', '=', True), ('state', 'not in', ('draft', 'sent', 'cancel'))]</field>
        <field name="context">{'search_default_filter_furnishing': 1, 'search_default_sales': 1, 'default_is_furnishing_project': True}</field>
    </record>

    <record id="action_project_furnishing_purchase_orders" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar,activity</field>
        <field name="search_view_id" ref="purchase.view_purchase_order_filter"/>
        <field name="domain">[('is_furnishing_project', '=', True)]</field>
        <field name="context">{'search_default_filter_furnishing': 1}</field>
    </record>

    <record id="action_project_furnishing_invoices" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt')), ('is_furnishing_project', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_filter_furnishing': 1, 'search_default_out_invoice': 1}</field>
    </record>

    <record id="action_project_furnishing_bills" model="ir.actions.act_window">
        <field name="name">Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')), ('is_furnishing_project', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_filter_furnishing': 1, 'search_default_in_invoice': 1}</field>
    </record>

    <record id="action_project_furnishing_payments" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form,graph</field>
        <field name="view_id" ref="account.view_account_payment_tree"/>
        <field name="search_view_id" ref="account.view_account_payment_search"/>
        <field name="domain">[('is_furnishing_project', '=', True)]</field>
        <field name="context">{'search_default_filter_furnishing': 1}</field>
    </record>

</odoo>
