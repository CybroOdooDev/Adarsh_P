<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Purchase Order Form to allow Buyers (purchase.group_purchase_user) to view and set project_id -->
    <record id="purchase_order_form_inherit_furnishing" model="ir.ui.view">
        <field name="name">purchase.order.form.furnishing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="project_purchase.view_order_form_inherit_project_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="groups">purchase.group_purchase_user,project.group_project_user</attribute>
            </xpath>
        </field>
    </record>

</odoo>
