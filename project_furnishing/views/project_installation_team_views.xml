<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Installation Team List View -->
    <record id="view_project_installation_team_list" model="ir.ui.view">
        <field name="name">project.installation.team.list</field>
        <field name="model">project.installation.team</field>
        <field name="arch" type="xml">
            <list string="Installation Teams">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="leader_id" widget="many2one_avatar_user"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="installation_count" string="Installations"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Installation Team Form View -->
    <record id="view_project_installation_team_form" model="ir.ui.view">
        <field name="name">project.installation.team.form</field>
        <field name="model">project.installation.team</field>
        <field name="arch" type="xml">
            <form string="Installation Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_installations" icon="build"
                                invisible="installation_count == 0">
                            <field string="Installations" name="installation_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Team Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Joinery &amp; Carpentry Team"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Leadership &amp; Company">
                            <field name="leader_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Settings">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Team Members" name="members">
                            <field name="member_ids" widget="many2many">
                                <list>
                                    <field name="name"/>
                                    <field name="login" string="Email / Login"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Installation Team Search View -->
    <record id="view_project_installation_team_search" model="ir.ui.view">
        <field name="name">project.installation.team.search</field>
        <field name="model">project.installation.team</field>
        <field name="arch" type="xml">
            <search string="Search Installation Teams">
                <field name="name" string="Team Name"/>
                <field name="leader_id" string="Team Leader"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Team Leader" name="group_leader" context="{'group_by': 'leader_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Installation Team Action -->
    <record id="action_project_installation_team" model="ir.actions.act_window">
        <field name="name">Installation Teams</field>
        <field name="res_model">project.installation.team</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_installation_team_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Installation Team!
            </p>
            <p>
                Organize technicians, joinery fixers, and supervisors into dedicated installation squads.
            </p>
        </field>
    </record>

</odoo>
