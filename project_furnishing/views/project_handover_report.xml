<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_handover_certificate" model="ir.actions.report">
        <field name="name">Handover Certificate</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_furnishing.report_handover_certificate</field>
        <field name="print_report_name">'Handover Certificate - %s' % object.name</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_handover_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Handover Certificate</h2>
                        <p><strong>Project:</strong> <span t-field="o.name"/></p>
                        <p><strong>Client:</strong> <span t-field="o.partner_id"/></p>
                        <p><strong>Site:</strong> <span t-field="o.site_address"/></p>
                        <p><strong>Handover date:</strong> <span t-field="o.handover_date"/></p>
                        <p>The works described above were inspected and accepted by
                           <strong t-field="o.handover_accepted_by"/>.</p>
                        <p t-if="o.has_warranty"><strong>Warranty:</strong>
                           <span t-field="o.warranty_start_date"/> to <span t-field="o.warranty_end_date"/> (<span t-field="o.warranty_months"/> months)</p>
                        <p t-if="o.retention_amount"><strong>Retention Held:</strong>
                           <span t-field="o.retention_amount"/> (Due: <span t-field="o.retention_release_date"/>)</p>
                        <p t-if="o.handover_notes"><strong>Notes:</strong> <span t-field="o.handover_notes"/></p>
                        <div t-if="o.handover_signature" style="margin-top:40px;">
                            <img t-att-src="image_data_uri(o.handover_signature)" style="max-height:80px;"/>
                            <div>Client signature</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
