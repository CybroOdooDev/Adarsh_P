<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Res Config Settings Form View Inherit -->
    <record id="res_config_settings_view_form_project_furnishing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.project.furnishing</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Furnishing Projects" string="Furnishing Projects" name="project_furnishing">
                    <block title="Operations &amp; Time Tracking" name="furnishing_operations_block">
                        <setting id="furnishing_timesheets_setting" help="Track time spent on furnishing projects, tasks, and site surveys">
                            <field name="module_hr_timesheet"/>
                            <div class="text-muted small">
                                Enable timesheets and task time tracking
                            </div>
                        </setting>
                    </block>
                    <block title="Pricing &amp; Catalog" name="furnishing_pricing_block">
                        <setting id="furnishing_pricelists_setting" help="Manage customer-specific pricelists, seasonal margins, and volume discounts">
                            <field name="group_product_pricelist"/>
                            <div class="text-muted small">
                                Enable pricelists submenu under Products
                            </div>
                        </setting>
                    </block>
                    <block title="Manufacturing &amp; Production" name="furnishing_production_block">
                        <setting id="furnishing_manufacturing_setting" help="Show the Production menu with Manufacturing Orders, Bills of Materials (BOM) and Quality Checks in Furnishing Projects">
                            <field name="group_furnishing_manufacturing"/>
                            <div class="text-muted small">
                                Enable Production menu (Manufacturing Orders, BOM, Quality Checks) in Furnishing Projects
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Action to open Furnishing Projects Settings -->
    <record id="action_project_furnishing_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'project_furnishing', 'bin_size': False}</field>
    </record>

</odoo>
