<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="meeting_transcription_summary.UploadRecordingDialog">
        <Dialog title="this.dialogTitle" size="'md'">
            <div class="p-3">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <!-- flex-shrink-0: the description beside it must not squeeze the channel name -->
                    <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2 rounded-pill flex-shrink-0 text-truncate"
                          style="max-width: 50%;" t-att-title="this.props.thread.displayName || this.props.thread.name">
                        <i class="oi me-1" data-icon="videocam"/>
                        <t t-out="this.props.thread.displayName || this.props.thread.name"/>
                    </span>
                    <span class="text-muted small">
                        Upload past audio/video recordings to transcribe &amp; generate meeting summaries
                    </span>
                </div>

                <!-- Uploading & Processing Progress Spinner -->
                <div t-if="this.state.isUploading" class="text-center py-4 my-2 bg-light rounded border">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Transcribing...</span>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Uploading Recording...</h6>
                    <p class="text-muted small px-4 mb-0">
                        Once uploaded, the recording is transcribed and summarized in the background: you can close this dialog and keep working.
                    </p>
                </div>

                <!-- Form Fields (hidden during uploading) -->
                <div t-if="!this.state.isUploading">
                    <!-- Error Alert -->
                    <div t-if="this.state.errorMessage" class="alert alert-danger d-flex align-items-start gap-2 mb-3" role="alert">
                        <i class="oi mt-1 flex-shrink-0" data-icon="warning"/>
                        <div>
                            <strong>Error: </strong><t t-out="this.state.errorMessage"/>
                        </div>
                    </div>

                    <!-- Success Alert -->
                    <div t-if="this.state.success" class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="oi oi-lg flex-shrink-0" data-icon="check_circle"/>
                        <div>
                            <strong>Done! </strong><t t-out="this.state.successMessage"/>
                        </div>
                    </div>

                    <div t-if="!this.state.success">
                        <!-- File Upload Input -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase text-secondary mb-1">
                                Meeting Recording File <span class="text-danger">*</span>
                            </label>
                            <input
                                type="file"
                                class="form-control"
                                accept="audio/*,video/*,.mp4,.webm,.mkv,.mov,.mp3,.wav,.m4a,.ogg"
                                t-on-change="this.onFileChange"
                            />
                            <div class="form-text small">
                                Supported formats: MP4, WebM, MKV, MOV, MP3, WAV, M4A. Max recommended size: 25MB.
                            </div>
                        </div>

                        <!-- Meeting Title Input -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase text-secondary mb-1">
                                Meeting Title
                            </label>
                            <input
                                type="text"
                                class="form-control"
                                placeholder="e.g. Sprint 24 Planning &amp; Review"
                                t-model.proxy="this.state.title"
                            />
                        </div>

                        <!-- Duration Input -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase text-secondary mb-1">
                                Meeting Duration (Minutes)
                            </label>
                            <input
                                type="number"
                                min="1"
                                class="form-control"
                                style="max-width: 150px;"
                                t-model.proxy.number="this.state.durationMinutes"
                            />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <t t-set-slot="footer">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <button t-if="this.state.summaryId" class="btn btn-outline-primary btn-sm" t-on-click="this.openSummaryRecord">
                            <i class="oi me-1" data-icon="open_in_new"/> View Summary Record
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary" t-on-click="this.props.close" t-att-disabled="this.state.isUploading">
                            <t t-if="this.state.success">Done</t>
                            <t t-else="">Cancel</t>
                        </button>
                        <button
                            t-if="!this.state.success"
                            class="btn btn-primary"
                            t-on-click="this.submitUpload"
                            t-att-disabled="!this.state.file || this.state.isUploading"
                        >
                            <i class="oi me-1" data-icon="wand_stars"/> Transcribe &amp; Post Summary
                        </button>
                    </div>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
