<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="driver_app_page" name="WM Driver App">
        <html lang="en">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <meta name="theme-color" content="#10b981"/>
                <meta name="description" content="Log waste collection stop statuses on the go — works offline."/>
                <title>WM Driver App</title>
                <link rel="manifest" href="/driver/app/manifest.json"/>
                <link rel="apple-touch-icon" href="/wm_driver_app/static/src/img/icon-192.png"/>
                <link rel="stylesheet" href="/wm_driver_app/static/src/css/app.css"/>
            </head>
            <body>
                <div id="app">
                    <!-- Splash / loading state -->
                    <div id="splash" class="splash active">
                        <div class="splash-logo">
                            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="64" height="64" rx="16" fill="#10b981"/>
                                <path d="M20 44 L32 20 L44 44" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="32" cy="48" r="2.5" fill="white"/>
                            </svg>
                        </div>
                        <p class="splash-text">WM Driver</p>
                        <div class="spinner"></div>
                    </div>

                    <!-- API key setup screen -->
                    <div id="screen-setup" class="screen setup-screen hidden">
                        <div class="setup-card">
                            <div class="screen-header">
                                <div class="app-logo">
                                    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect width="64" height="64" rx="18" fill="url(#setup-logo-grad)"/>
                                        <path d="M20 44 L32 20 L44 44" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        <circle cx="32" cy="48" r="2.5" fill="white"/>
                                        <defs>
                                            <linearGradient id="setup-logo-grad" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
                                                <stop stop-color="#10B981"/>
                                                <stop offset="1" stop-color="#059669"/>
                                            </linearGradient>
                                        </defs>
                                    </svg>
                                </div>
                                <h1>WM Driver App</h1>
                                <p class="subtitle">Enter your personal API key to get started</p>
                            </div>
                            <div class="setup-form">
                                <div class="input-group">
                                    <label for="input-server-url">Odoo Server URL</label>
                                    <input id="input-server-url" type="url" placeholder="https://your-odoo.example.com" autocomplete="url"/>
                                </div>
                                <div class="input-group">
                                    <label for="select-database">Database</label>
                                    <select id="select-database" class="form-select">
                                        <option value="" disabled="disabled" selected="selected">Loading databases...</option>
                                    </select>
                                </div>
                                <div class="input-group">
                                    <label for="input-api-key">API Key</label>
                                    <input id="input-api-key" type="password" placeholder="Paste your API key here" autocomplete="off"/>
                                </div>
                                <p class="hint">
                                    Generate your key in Odoo &#x2192; Settings &#x2192; Users &#x2192; (your account) &#x2192; API Keys &#x2192; New Key
                                </p>
                                <button id="btn-save-key" class="btn btn-primary btn-full">Connect</button>
                                <div id="setup-error" class="error-banner hidden"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Main stop list screen -->
                    <div id="screen-home" class="screen hidden">
                        <header class="app-header">
                            <div class="header-left">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="header-icon">
                                    <rect width="24" height="24" rx="6" fill="#10b981"/>
                                    <path d="M7 16 L12 7 L17 16" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="12" cy="18" r="1" fill="white"/>
                                </svg>
                                <span class="header-title">Today's Route</span>
                            </div>
                            <div class="header-right">
                                <div id="sync-indicator" class="sync-dot synced" title="All synced"></div>
                                <button id="btn-refresh" class="icon-btn" title="Refresh route">
                                    <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"/>
                                    </svg>
                                </button>
                                <button id="btn-logout" class="icon-btn" title="Sign out">
                                    <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd"/>
                                    </svg>
                                </button>
                            </div>
                        </header>

                        <div class="date-bar">
                            <span id="today-date"></span>
                            <span id="stop-count" class="badge"></span>
                        </div>

                        <div id="offline-banner" class="offline-banner hidden">
                            <svg viewBox="0 0 20 20" fill="currentColor" class="icon-sm">
                                <path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"/>
                                <path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z"/>
                            </svg>
                            Offline &#x2014; queued updates will sync when connected
                        </div>

                        <div id="location-banner" class="location-banner hidden" role="status">
                            <svg viewBox="0 0 20 20" fill="currentColor" class="icon-sm">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                            </svg>
                            <span id="location-banner-text"></span>
                        </div>

                        <div id="stop-list" class="stop-list"></div>

                        <div id="empty-state" class="empty-state hidden">
                            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="32" cy="32" r="28" fill="#131927"/>
                                <path d="M20 40 L32 24 L44 40" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="32" cy="44" r="2" fill="#10b981"/>
                            </svg>
                            <p>No stops assigned for today.</p>
                        </div>
                    </div>

                    <!-- Stop detail / action screen -->
                    <div id="screen-stop" class="screen hidden">
                        <header class="app-header">
                            <button id="btn-back" class="icon-btn">
                                <svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                                </svg>
                            </button>
                            <span class="header-title" id="stop-header-title">Stop Detail</span>
                            <div class="header-right"></div>
                        </header>

                        <div class="stop-detail-card">
                            <div class="stop-detail-name" id="stop-detail-name"></div>
                            <div class="stop-detail-customer" id="stop-detail-customer"></div>
                            <div class="stop-detail-address" id="stop-detail-address"></div>
                            <div class="stop-detail-time" id="stop-detail-time"></div>
                        </div>

                        <div class="section-label">Current Status</div>
                        <div class="current-status-badge" id="current-status-badge">&#x2013;</div>

                        <div class="section-label" id="section-label-log-status">Log Status</div>
                        <div class="status-grid" id="status-grid">
                            <button class="status-btn status-en-route" data-status="en_route">&#x1F69A; En Route</button>
                            <button class="status-btn status-arrived" data-status="arrived">&#x1F4CD; Arrived</button>
                            <button class="status-btn status-started" data-status="started">&#x25B6;&#xFE0F; Started</button>
                            <button class="status-btn status-lifted" data-status="lifted">&#x2B06;&#xFE0F; Lifted</button>
                            <button class="status-btn status-weighed" data-status="weighed">&#x2696;&#xFE0F; Weighed</button>
                            <button class="status-btn status-completed" data-status="completed">&#x2705; Completed</button>
                            <button class="status-btn status-flagged" data-status="flagged">&#x1F6A9; Flag Issue</button>
                        </div>

                        <div class="section-label">Log History</div>
                        <div class="log-history" id="log-history"></div>
                    </div>

                    <!-- Flag-reason prompt modal -->
                    <div id="modal-flag" class="modal-overlay hidden">
                        <div class="modal-card">
                            <h2 class="modal-title">Flag Issue</h2>
                            <p class="modal-desc">Flagging marks this stop as missed. Pick a reason and describe what happened.</p>
                            <div class="input-group">
                                <label for="flag-reason">Reason</label>
                                <select id="flag-reason" class="form-select"></select>
                            </div>
                            <textarea id="flag-note" rows="3" placeholder="Describe the issue..." maxlength="500"></textarea>

                            <div class="photo-section">
                                <label for="flag-photo-input" class="btn btn-ghost btn-full">
                                    <svg viewBox="0 0 20 20" fill="currentColor" class="icon-sm">
                                        <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
                                    </svg>
                                    Attach Photo (optional)
                                </label>
                                <input id="flag-photo-input" type="file" accept="image/*" capture="environment" class="hidden"/>
                                <div id="flag-photo-preview" class="photo-preview hidden"></div>
                            </div>

                            <div class="modal-actions">
                                <button id="btn-flag-cancel" class="btn btn-ghost">Cancel</button>
                                <button id="btn-flag-confirm" class="btn btn-danger">Flag Stop</button>
                            </div>
                        </div>
                    </div>

                    <!-- Generic photo prompt modal (for non-flag statuses) -->
                    <div id="modal-photo" class="modal-overlay hidden">
                        <div class="modal-card">
                            <h2 class="modal-title" id="photo-modal-title">Add Photo?</h2>
                            <p class="modal-desc">Optionally attach a photo proof, then tap Submit. Cancel closes this without logging anything.</p>
                            <div class="photo-section">
                                <label for="status-photo-input" class="btn btn-ghost btn-full">
                                    <svg viewBox="0 0 20 20" fill="currentColor" class="icon-sm">
                                        <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
                                    </svg>
                                    Take / Choose Photo
                                </label>
                                <input id="status-photo-input" type="file" accept="image/*" capture="environment" class="hidden"/>
                                <div id="status-photo-preview" class="photo-preview hidden"></div>
                            </div>
                            <div class="modal-actions">
                                <button id="btn-photo-cancel" class="btn btn-ghost">Cancel</button>
                                <button id="btn-photo-confirm" class="btn btn-primary">Submit</button>
                            </div>
                        </div>
                    </div>

                    <!-- Weighed status category weight prompt modal -->
                    <div id="modal-weighed" class="modal-overlay hidden">
                        <div class="modal-card modal-card-lg">
                            <h2 class="modal-title">⚖️ Record Waste Weights</h2>
                            <p class="modal-desc">Select a waste category from this order and enter the recorded weight.</p>

                            <div class="input-group" style="margin-bottom: 14px;">
                                <label for="weighed-category-select">Select Waste Category</label>
                                <select id="weighed-category-select" class="form-select"></select>
                            </div>

                            <div id="weighed-lines-list" class="weighed-lines-list"></div>

                            <div class="photo-section">
                                <label for="weighed-photo-input" class="btn btn-ghost btn-full">
                                    <svg viewBox="0 0 20 20" fill="currentColor" class="icon-sm">
                                        <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
                                    </svg>
                                    Attach Weight Scale Photo (optional)
                                </label>
                                <input id="weighed-photo-input" type="file" accept="image/*" capture="environment" class="hidden"/>
                                <div id="weighed-photo-preview" class="photo-preview hidden"></div>
                            </div>

                            <div class="modal-actions">
                                <button id="btn-weighed-cancel" class="btn btn-ghost">Cancel</button>
                                <button id="btn-weighed-confirm" class="btn btn-primary">Submit Weights</button>
                            </div>
                        </div>
                    </div>

                    <!-- Toast notification -->
                    <div id="toast" class="toast hidden"></div>
                </div>

                <script src="/wm_driver_app/static/src/js/app.js?v=6"></script>
            </body>
        </html>
    </template>
</odoo>
