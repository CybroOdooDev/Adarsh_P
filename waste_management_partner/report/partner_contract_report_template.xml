<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <data>
       <template id="report_partner_contract_document">
           <t t-call="web.html_container">
               <t t-foreach="docs" t-as="o">
                   <t t-call="web.external_layout">
                       <div class="page">

                           <!-- CLIENT INFORMATION -->
                           <h3 style="border-left:4px solid #001f5b; padding-left:10px; color:#001f5b; margin-bottom:8px; font-size:14px;">Client Information</h3>
                           <table style="width:100%; border-collapse:collapse; margin-bottom:20px; font-size:12px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                               <thead>
                                   <tr>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Client Name</th>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Address</th>
                                   </tr>
                               </thead>
                               <tbody>
                                   <tr t-foreach="o.partner_id" t-as="line">
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; color:#2c3e50;"><span t-field="line.name"/></td>
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; color:#2c3e50; line-height:1.6;">
                                            <t t-if="line.street"><span t-esc="line.street"/><br/></t>
                                            <t t-if="line.street2"><span t-esc="line.street2"/><br/></t>
                                            <t t-if="line.city"><span t-esc="line.city"/></t><t t-if="line.state_id">, <span t-esc="line.state_id.name"/></t><t t-if="line.zip"> - <span t-esc="line.zip"/></t><t t-if="line.city or line.state_id or line.zip"><br/></t>
                                            <t t-if="line.country_id"><span t-esc="line.country_id.name"/></t>
                                        </td>
                                   </tr>
                               </tbody>
                               <thead>
                                   <tr>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Email</th>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Phone</th>
                                   </tr>
                               </thead>
                               <tbody>
                                   <tr t-foreach="o.partner_id" t-as="line">
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; color:#2c3e50;"><span t-field="line.email"/></td>
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; color:#2c3e50;"><span t-field="line.phone"/></td>
                                   </tr>
                               </tbody>
                           </table>

                           <!-- SERVICE PROVIDER -->
                           <h3 style="border-left:4px solid #001f5b; padding-left:10px; color:#001f5b; margin-bottom:8px; font-size:14px;">Service Provider</h3>
                           <table style="width:100%; border-collapse:collapse; margin-bottom:20px; font-size:12px; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
                               <thead>
                                   <tr>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Company Name</th>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Address</th>
                                   </tr>
                               </thead>
                               <tbody>
                                   <tr>
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; border-left:3px solid #001f5b; background-color:#f3f7ff; color:#2c3e50;"><span t-esc="o.env.company.name"/></td>
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; color:#2c3e50;"><span t-esc="o.env.company.street or ''"/><t t-if="o.env.company.city">, <span t-esc="o.env.company.city"/></t><t t-if="o.env.company.country_id">, <span t-esc="o.env.company.country_id.name"/></t></td>
                                   </tr>
                               </tbody>
                               <thead>
                                   <tr>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Email</th>
                                       <th style="background-color:#001f5b; color:#ffffff; font-weight:bold; padding:9px 14px; text-transform:uppercase; letter-spacing:0.6px; font-size:11px; border:1px solid #003366;">Phone</th>
                                   </tr>
                               </thead>
                               <tbody>
                                   <tr>
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; border-left:3px solid #001f5b; background-color:#ffffff; color:#2c3e50;"><span t-esc="o.env.company.email or ''"/></td>
                                       <td style="padding:8px 14px; border:1px solid #dce6f5; background-color:#ffffff; color:#2c3e50;"><span t-esc="o.env.company.phone or ''"/></td>
                                   </tr>
                               </tbody>
                           </table>

                           <!-- DIVIDER -->
                           <hr style="border:none; border-top:2px solid #001f5b; margin:20px 0;"/>

                           <!-- CONTRACT PERIOD BANNER -->
                           <div style="background-color:#001f5b; color:#ffffff; border-radius:4px; padding:10px 16px; margin-bottom:18px; display:flex;">
                               <span style="font-weight:bold; font-size:13px; margin-right:8px;">&#128197; Contract Period:</span>
                               <span style="font-size:13px;">
                                   <t t-if="o.from_date"><span t-field="o.from_date"/></t><t t-else="">—</t>
                                   &amp;nbsp;&amp;nbsp;&#8594;&amp;nbsp;&amp;nbsp;
                                   <t t-if="o.to_date"><span t-field="o.to_date"/></t><t t-else="">—</t>
                               </span>
                           </div>

                           <!-- CONTRACT LINES — CARD STYLE -->
                           <h3 style="border-left:4px solid #001f5b; padding-left:10px; color:#001f5b; margin-bottom:12px; font-size:14px;">Contract Services</h3>
                           <t t-foreach="o.contract_line_ids" t-as="line">
                               <div style="display:flex; align-items:stretch; border:1px solid #003366; border-radius:4px; margin-bottom:10px; overflow:hidden;">
                                   <!-- Left accent strip -->
                                   <div style="width:6px; background-color:#001f5b; flex-shrink:0;"></div>
                                   <!-- Content -->
                                   <div style="flex:1; padding:10px 14px;">
                                       <div style="font-weight:bold; font-size:13px; color:#001f5b; margin-bottom:4px;">
                                           <span t-field="line.product_id.name"/>
                                       </div>
                                       <div style="font-size:12px; color:#444444;">
                                           Waste Type: <span t-field="line.product_id.categ_id.name"/>
                                       </div>
                                   </div>
                                   <!-- Right price badge -->
                                   <div style="background-color:#f0f4ff; padding:10px 18px; display:flex; align-items:center; border-left:1px solid #003366;">
                                       <span style="font-weight:bold; font-size:14px; color:#001f5b;">
                                           <span t-field="line.price"/>
                                           &amp;nbsp;<span t-field="line.currency_id.symbol"/>
                                           <span style="font-size:10px; font-weight:normal; color:#666;">&amp;nbsp;/ kg</span>
                                       </span>
                                   </div>
                               </div>
                           </t>


                           <!-- SIGNATURE SECTION -->
                           <div style="margin-top:50px; page-break-inside:avoid;">
                               <hr style="border:none; border-top:1px solid #dce6f5; margin-bottom:30px;"/>
                               <table style="width:100%; border-collapse:collapse;">
                                   <tr>
                                       <!-- CLIENT SIGNATURE -->
                                       <td style="width:45%; text-align:center; padding:0 10px; vertical-align:bottom;">
                                           <div style="height:50px;"></div>
                                           <div style="border-top:2px solid #001f5b; padding-top:8px; margin-bottom:6px;">
                                               <span style="font-weight:bold; font-size:12px; color:#001f5b; text-transform:uppercase; letter-spacing:0.5px;">Client Signature</span>
                                           </div>
                                           <div style="font-size:11px; color:#2c3e50; margin-top:4px;">
                                               <span t-field="o.partner_id.name"/>
                                           </div>
                                           <div style="font-size:10px; color:#999999; margin-top:4px;">Date: ___________________</div>
                                       </td>
                                       <!-- SPACER -->
                                       <td style="width:10%;"></td>
                                       <!-- PROVIDER SIGNATURE -->
                                       <td style="width:45%; text-align:center; padding:0 10px; vertical-align:bottom;">
                                           <div style="height:50px;"></div>
                                           <div style="border-top:2px solid #001f5b; padding-top:8px; margin-bottom:6px;">
                                               <span style="font-weight:bold; font-size:12px; color:#001f5b; text-transform:uppercase; letter-spacing:0.5px;">Service Provider Signature</span>
                                           </div>
                                           <div style="font-size:11px; color:#2c3e50; margin-top:4px;">
                                               <span t-esc="o.env.company.name"/>
                                           </div>
                                           <div style="font-size:10px; color:#999999; margin-top:4px;">Date: ___________________</div>
                                       </td>
                                   </tr>
                               </table>
                           </div>

                       </div>
                   </t>
               </t>
           </t>
       </template>
   </data>

    <data>
       <template id="report_machine_transfer_document">
           <t t-call="web.html_container">
               <t t-foreach="docs" t-as="o">
                   <t t-call="web.external_layout">
                       <div class="page">
                           <h2>Machine : <span t-field="o.machine_id.name"/></h2>
                           <p>Transfer Type : <span t-field="o.transfer_type"/></p>
                           <p>Customer : <span t-field="o.partner_id.name"/></p>
                           <p>Transfer From : <span t-field="o.transfer_date"/></p>
                           <p>Transfer To : <span t-field="o.transfer_to_date"/></p>
                       </div>
                   </t>
               </t>
           </t>
       </template>
   </data>
</odoo>


