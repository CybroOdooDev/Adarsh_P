<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Window view for Machine Menu-->
    <record id="action_menu_partner_contract_wm" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">partner.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Partner Contract</p>
        </field>
    </record>

    <record id="wm_partner_contract_form" model="ir.ui.view">
        <field name="name">wm.partner.comtract.form</field>
        <field name="model">partner.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="container_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Type">
                            <group>
                                <field
                                name="contract_line_ids"
                                string=""
                                widget="sol_o2m"
                                mode="list"
                                >
                                        <form>
                                            <group>
                                                <field name="product_id" widget="many2one_barcode" />
                                                <field name="price"/>
                                            </group>
                                        </form>
                                    </field>
                                </group>
                            </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
