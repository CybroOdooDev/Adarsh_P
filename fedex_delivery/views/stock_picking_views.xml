<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_fedex" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.fedex</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']//group[@name='other_infos']" position="inside">
                <field name="number_of_packages"/>
            </xpath>
        </field>
    </record>
</odoo>
