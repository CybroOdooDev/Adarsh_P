<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  Added new fields to employee form view  -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.cost.per.employee.manufacturing</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='work_information']//field[@name='parent_id']" position="after">
                <field name="hour_per_cost"/>
            </xpath>
        </field>
    </record>
</odoo>
