<odoo>
    <record id="demo_checklist_cold_chain" model="pharma.dispatch.checklist.template">
        <field name="name">Cold Chain (2–8 °C) Pre-Loading Checklist</field>
        <field name="temperature_controlled" eval="True"/>
        <field name="temp_min">2.0</field>
        <field name="temp_max">8.0</field>
        <field name="sequence">20</field>
    </record>
    <record id="demo_checklist_cold_chain_line_1" model="pharma.dispatch.checklist.template.line">
        <field name="template_id" ref="demo_checklist_cold_chain"/>
        <field name="sequence">10</field>
        <field name="section">vehicle</field>
        <field name="name">Closed body with no holes, rust-through, cracks or gaps; roof and floor intact</field>
        <field name="check_type">yes_no</field>
        <field name="severity">critical</field>
        <field name="applies_to">all</field>
        <field name="photo_required" eval="True"/>
    </record>
    <record id="demo_checklist_cold_chain_line_2" model="pharma.dispatch.checklist.template.line">
