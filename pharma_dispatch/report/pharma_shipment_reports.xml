<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_packing_list" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">pharma.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pharma_dispatch.report_packing_list</field>
        <field name="print_report_name">'Packing List - %s' % object.name</field>
        <field name="binding_model_id" ref="model_pharma_shipment"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_delivery_challan" model="ir.actions.report">
        <field name="name">Delivery Challan</field>
        <field name="model">pharma.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pharma_dispatch.report_delivery_challan</field>
        <field name="print_report_name">'Delivery Challan - %s' % (object.challan_number or object.name)</field>
        <field name="binding_model_id" ref="model_pharma_shipment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
