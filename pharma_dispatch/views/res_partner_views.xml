<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_pharma_dispatch" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.pharma.dispatch</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_transport_contracts" type="object"
                        class="oe_stat_button" icon="contract"
                        invisible="not transport_contract_count"
                        groups="stock.group_stock_user">
                    <field name="transport_contract_count" string="Transport Contracts" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="pharma_dl_20b" invisible="parent_id"/>
                <field name="pharma_dl_21b" invisible="parent_id"/>
                <field name="pharma_dl_valid_until"
                       invisible="not (pharma_dl_20b or pharma_dl_21b)"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Transport Qualification" name="transport_qualification"
                      invisible="not (transport_role or parent_id)"
                      groups="stock.group_stock_user">
                    <div class="alert alert-danger" role="alert"
                         invisible="transport_qualification_state != 'not_qualified'">
                        <strong>Not qualified:</strong>
                        <field name="transport_qualification_issues" class="d-inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="transport_qualification_state != 'expiring'">
                        The driving licence expires within 30 days.
                    </div>
                    <group>
                        <group>
                            <field name="transport_role"/>
                            <field name="cold_chain_trained" invisible="not transport_role"/>
                            <field name="transport_qualification_state" invisible="not transport_role"
                                   widget="badge"
                                   decoration-success="transport_qualification_state == 'qualified'"
                                   decoration-warning="transport_qualification_state == 'expiring'"
                                   decoration-danger="transport_qualification_state == 'not_qualified'"/>
                        </group>
                    </group>
                    <group invisible="not transport_role">
                        <group string="Driving Licence" invisible="transport_role != 'driver'">
                            <field name="driving_licence_number"/>
                            <field name="driving_licence_class" placeholder="e.g. LMV, HGMV, Transport"/>
                            <field name="driving_licence_valid_until"/>
                        </group>
                        <group string="Background Verification">
                            <field name="background_check_date"/>
                            <field name="background_check_valid_until"/>
                        </group>
                        <group string="Documents">
                            <field name="transport_document_ids" widget="many2many_binary"
                                   nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
