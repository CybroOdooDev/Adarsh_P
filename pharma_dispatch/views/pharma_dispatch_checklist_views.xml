<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates -->
    <record id="pharma_dispatch_checklist_template_view_list" model="ir.ui.view">
        <field name="name">pharma.dispatch.checklist.template.list</field>
        <field name="model">pharma.dispatch.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="temperature_controlled"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="pharma_dispatch_checklist_template_view_form" model="ir.ui.view">
        <field name="name">pharma.dispatch.checklist.template.form</field>
        <field name="model">pharma.dispatch.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Cold Chain Pre-Loading Checklist"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="temperature_controlled"/>
                            <label for="temp_min" string="Allowed Range (°C)"
                                   invisible="not temperature_controlled"/>
                            <div class="o_row" invisible="not temperature_controlled">
                                <field name="temp_min"/><span>to</span><field name="temp_max"/>
                            </div>
                        </group>
                        <group>
                            <field name="high_security"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="section"/>
                            <field name="name"/>
                            <field name="check_type"/>
                            <field name="severity"/>
                            <field name="applies_to"/>
                            <field name="limit_source" invisible="check_type != 'numeric'"/>
                            <field name="min_value" invisible="check_type != 'numeric' or limit_source != 'fixed'"/>
                            <field name="max_value" invisible="check_type != 'numeric' or limit_source != 'fixed'"/>
                            <field name="unit" invisible="check_type != 'numeric'" optional="hide"/>
                            <field name="log_temperature" invisible="check_type != 'numeric'" optional="show"/>
                            <field name="photo_required"/>
                            <field name="instructions" optional="hide"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Critical: a failure rejects the vehicle. Major: a failure needs a manager
                        override to load. Minor: recorded only. Readings against the shipment
                        range are skipped for shipments that are not temperature controlled.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pharma_dispatch_checklist_template_action" model="ir.actions.act_window">
        <field name="name">Dispatch Checklist Templates</field>
        <field name="res_model">pharma.dispatch.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Checklists -->
    <record id="pharma_dispatch_checklist_view_list" model="ir.ui.view">
        <field name="name">pharma.dispatch.checklist.list</field>
        <field name="model">pharma.dispatch.checklist</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="vehicle_number"/>
                <field name="checked_by"/>
                <field name="checked_on"/>
                <field name="overridden" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'passed'"
                       decoration-warning="state == 'failed'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="pharma_dispatch_checklist_view_form" model="ir.ui.view">
        <field name="name">pharma.dispatch.checklist.form</field>
        <field name="model">pharma.dispatch.checklist</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_complete" string="Complete Checklist" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_override" string="Override and Allow Loading" type="object"
                            class="oe_highlight" groups="stock.group_stock_manager"
                            invisible="state != 'failed'"
                            confirm="Allow loading on this vehicle despite the failed major checks?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-danger mb-0" role="alert" invisible="state != 'rejected'">
                    A critical check failed: this vehicle cannot be loaded.
                    Arrange another vehicle on the shipment and start a new checklist.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'failed'">
                    Major checks failed. An inventory manager can override with a reason,
                    or arrange another vehicle.
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="vehicle_number" readonly="state != 'in_progress'"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="temperature_controlled"/>
                            <label for="temp_min" string="Allowed Range (°C)"
                                   invisible="not temperature_controlled"/>
                            <div class="o_row" invisible="not temperature_controlled">
                                <field name="temp_min"/><span>to</span><field name="temp_max"/>
                            </div>
                            <field name="checked_by" invisible="not checked_by"/>
                            <field name="checked_on" invisible="not checked_on"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'in_progress'">
                        <list editable="bottom" create="0" delete="0"
                              class="o_pharma_checklist_lines"
                              decoration-danger="result == 'fail'"
                              decoration-success="result == 'pass'">
                            <field name="section"/>
                            <field name="name"/>
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'critical'"
                                   decoration-warning="severity == 'major'"/>
                            <field name="check_type" column_invisible="1"/>
                            <field name="value_entered" column_invisible="1"/>
                            <field name="answer" widget="radio" options="{'horizontal': true}"
                                   invisible="check_type != 'yes_no'"/>
                            <field name="value_numeric" invisible="check_type != 'numeric'"/>
                            <field name="min_value" invisible="check_type != 'numeric'" optional="show"/>
                            <field name="max_value" invisible="check_type != 'numeric'" optional="show"/>
                            <field name="unit" invisible="check_type != 'numeric'" optional="hide"/>
                            <field name="value_text" invisible="check_type != 'text'"/>
                            <field name="photo_required" column_invisible="1"/>
                            <field name="photo" widget="image" options="{'size': [40, 40]}"
                                   decoration-danger="photo_required and not photo and parent.state == 'in_progress'"/>
                            <field name="remarks" optional="show"/>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'pass'"
                                   decoration-danger="result == 'fail'"/>
                        </list>
                    </field>
                    <group invisible="state not in ('failed', 'passed') or (state == 'passed' and not overridden)">
                        <field name="override_reason" readonly="state != 'failed'"
                               placeholder="Why loading is allowed despite the failed checks"/>
                        <field name="overridden_by" invisible="not overridden"/>
                    </group>
                    <group>
                        <group>
                            <field name="failed_critical_count"/>
                            <field name="failed_major_count"/>
                            <field name="failed_minor_count"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pharma_dispatch_checklist_view_search" model="ir.ui.view">
        <field name="name">pharma.dispatch.checklist.search</field>
        <field name="model">pharma.dispatch.checklist</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="vehicle_number"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="rejected" string="Vehicle Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="overridden" string="Overridden" domain="[('overridden', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="pharma_dispatch_checklist_action" model="ir.actions.act_window">
        <field name="name">Dispatch Checklists</field>
        <field name="res_model">pharma.dispatch.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checklists yet</p>
            <p>Start a checklist from a draft shipment once the vehicle reports at the dock.</p>
        </field>
    </record>
</odoo>
