<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_navbar_breadcrumbs')]" position="before">
            <!-- Mobile Sidebar Toggle Button -->
            <button class="ef-sidebar-mobile-toggle-btn ef-sidebar-toggle-btn btn shadow-none p-0 me-2 align-items-center justify-content-center"
                    t-on-click="() => this.toggleMobileSidebar()"
                    title="Toggle Sidebar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <line x1="4" y1="18" x2="20" y2="18"></line>
                </svg>
            </button>

            <!-- App Brand Dashboard Trigger / Home Navigation -->
            <div t-if="!this.isSmallScreen and this.currentApp and !this.hasEnterpriseHomeMenu"
                 class="o_menu_brand ef-custom-brand d-flex align-items-center me-3"
                 t-on-click="() => this.toggleAppsDashboard()"
                 t-att-title="this.currentApp.name">
                <div class="ef-brand-icon-wrap me-2">
                    <img t-if="this.currentApp.webIconData" t-attf-src="{{this.currentApp.webIconData}}" class="ef-brand-app-icon" alt="App Icon"/>
                    <i t-else="" class="oi oi-apps ef-brand-app-icon ef-brand-app-icon-fallback"/>
                </div>
                <span t-out="this.currentApp.name"/>
            </div>

            <!-- ========================================================= -->
            <!-- 1. DESKTOP SIDEBAR (Screens >= 1025px): Apps List Only -->
            <!-- ========================================================= -->
            <t t-if="!this.isSmallScreen">
                <t t-custom-portal="'body'">
                    <div class="ef-custom-sidebar ef-desktop-sidebar d-flex flex-column" 
                         t-att-class="{'collapsed': this.state.isSidebarCollapsed}">
                        
                        <!-- Desktop Sidebar Header -->
                        <div class="ef-sidebar-header d-flex align-items-center justify-content-between w-100 px-3 py-3">
                            <span class="ef-sidebar-header-title fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.8px; color: #94A3B8;">
                                SIDEBAR
                            </span>
                            <button class="ef-sidebar-inner-toggle btn shadow-none"
                                    t-on-click="() => this.toggleSidebarCollapse()"
                                    t-att-title="this.state.isSidebarCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar'">
                                <svg t-if="!this.state.isSidebarCollapsed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="15 18 9 12 15 6"></polyline>
                                </svg>
                                <svg t-if="this.state.isSidebarCollapsed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </button>
                        </div>

                        <!-- Installed Applications List Only -->
                        <div class="ef-sidebar-apps w-100 px-2 flex-grow-1 overflow-auto">
                            <t t-foreach="this.menuService.getApps()" t-as="app" t-key="app.id">
                                <div class="nav-item mb-1">
                                    <a t-att-href="this.getMenuItemHref(app)" 
                                       class="ef-app-link d-flex align-items-center w-100 text-decoration-none rounded-3 py-2 px-2"
                                       t-att-class="{'active': this.menuService.getCurrentApp() === app}"
                                       t-att-title="app.name"
                                       t-on-click.prevent="() => this.onNavBarDropdownItemSelection(app)">
                                        <div class="ef-sidebar-app-icon-wrap d-flex align-items-center justify-content-center me-2">
                                            <img t-if="app.webIconData" t-attf-src="{{app.webIconData}}" class="ef-app-icon" />
                                            <i t-else="" class="oi oi-apps fs-5 text-secondary"/>
                                        </div>
                                        <span class="ef-sidebar-app-name text-truncate fw-semibold" style="font-size: 13px;"><t t-out="app.name"/></span>
                                    </a>
                                </div>
                            </t>
                        </div>

                        <!-- Desktop Sidebar Footer Quick Toggle -->
                        <div class="ef-sidebar-footer border-top border-dark w-100 p-2 mt-auto d-flex align-items-center">
                            <button class="ef-sidebar-bottom-toggle btn w-100 d-flex align-items-center justify-content-center text-decoration-none shadow-none"
                                    t-on-click="() => this.toggleSidebarCollapse()"
                                    t-att-title="this.state.isSidebarCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar'">
                                <svg t-if="!this.state.isSidebarCollapsed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                    <polyline points="11 17 6 12 11 7"></polyline>
                                    <polyline points="18 17 13 12 18 7"></polyline>
                                </svg>
                                <svg t-if="this.state.isSidebarCollapsed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 17 11 12 6 7"></polyline>
                                    <polyline points="13 17 18 12 13 7"></polyline>
                                </svg>
                                <span class="ef-sidebar-footer-text fw-medium" style="font-size: 12px;">Collapse</span>
                            </button>
                        </div>
                    </div>
                </t>
            </t>

            <!-- ========================================================= -->
            <!-- 2. MOBILE & IPAD 10 SIDEBAR DRAWER (< 1025px) -->
            <!-- ========================================================= -->
            <t t-if="this.isSmallScreen">
                <!-- Mobile Slide-out Navigation Drawer Portaled to Body -->
                <t t-custom-portal="'body'">
                    <div class="ef-custom-sidebar ef-mobile-sidebar d-flex flex-column d-lg-none" 
                         t-att-class="{'mobile-open': this.state.isMobileSidebarOpen}">
                        
                        <!-- Mobile Drawer Header -->
                        <div class="ef-sidebar-header d-flex align-items-center justify-content-between w-100 px-3 py-3">
                            <span class="ef-sidebar-header-title fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.8px; color: #6B7280;">
                                Navigation
                            </span>
                            <button class="btn-close shadow-none" 
                                    t-on-click="() => this.toggleMobileSidebar()" 
                                    aria-label="Close"/>
                        </div>

                        <!-- Mobile Drawer Content: Active App Submenus + Installed Apps -->
                        <div class="ef-sidebar-apps w-100 px-2 flex-grow-1 overflow-auto">
                            
                            <!-- Active App Submenus Section (Mobile / Tablet Only) -->
                            <t t-if="this.currentApp &amp;&amp; this.currentAppSections &amp;&amp; this.currentAppSections.length">
                                <div class="ef-sidebar-heading text-uppercase fw-bold px-2 mt-2 mb-1" style="color: #10B981; font-size: 10px; letter-spacing: 1px;">
                                    <t t-out="this.currentApp.name"/> Menu
                                </div>
                                <t t-call="wm_base.SidebarMenuTree" menuItems="this.currentAppSections"/>
                                <hr class="my-2 border-secondary opacity-25"/>
                            </t>

                            <!-- Installed Applications Section -->
                            <div class="ef-sidebar-heading text-uppercase fw-bold px-2 mt-1 mb-1" style="color: #6B7280; font-size: 10px; letter-spacing: 1px;">
                                Applications
                            </div>
                            <t t-foreach="this.menuService.getApps()" t-as="app" t-key="app.id">
                                <div class="nav-item mb-1">
                                    <a t-att-href="this.getMenuItemHref(app)" 
                                       class="ef-app-link d-flex align-items-center w-100 text-decoration-none rounded-3 py-2 px-2"
                                       t-att-class="{'active': this.menuService.getCurrentApp() === app}"
                                       t-att-title="app.name"
                                       t-on-click.prevent="() => this.onSidebarAppClick(app)">
                                        <div class="ef-sidebar-app-icon-wrap d-flex align-items-center justify-content-center me-2">
                                            <img t-if="app.webIconData" t-attf-src="{{app.webIconData}}" class="ef-app-icon" />
                                            <i t-else="" class="oi oi-apps fs-5 text-secondary"/>
                                        </div>
                                        <span class="ef-sidebar-app-name text-truncate fw-semibold" style="font-size: 13px;"><t t-out="app.name"/></span>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Mobile Backdrop Overlay -->
                    <div t-if="this.state.isMobileSidebarOpen" 
                         class="ef-sidebar-mobile-backdrop position-fixed top-0 start-0 w-100 h-100 d-lg-none"
                         t-on-click="() => this.toggleMobileSidebar()"/>
                </t>
            </t>

            <!-- Full-Screen All Apps Dashboard Overlay -->
            <t t-custom-portal="'body'">
                <div t-if="this.state.isAppsDashboardOpen" 
                     class="ef-apps-dashboard position-fixed top-0 start-0 w-100 h-100 d-flex flex-column align-items-center overflow-auto p-4 p-md-5"
                     t-on-click="(ev) => this.onOverlayClick(ev)">

                    <!-- Search Filter Bar -->
                    <div class="ef-apps-search-container mb-4 w-100 position-relative d-flex align-items-center justify-content-center">
                        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden ef-search-group w-100">
                            <span class="input-group-text bg-transparent border-0 ps-3 pe-2 text-muted">
                                <i class="oi oi-search fs-5 text-muted"/>
                            </span>
                            <input type="text" 
                                   class="form-control border-0 shadow-none fs-6 ps-2 pe-3 text-white" 
                                   placeholder="Search applications..." 
                                   t-model.proxy="this.state.appsSearchQuery"/>
                        </div>
                    </div>

                    <!-- App Cards Grid -->
                    <div class="ef-apps-grid d-grid gap-3 gap-md-4 w-100 mt-1 mb-auto">
                        <t t-foreach="this.filteredApps" t-as="app" t-key="app.id">
                            <a t-att-href="this.getMenuItemHref(app)" 
                               class="ef-app-card d-flex flex-column align-items-center justify-content-center p-3 text-decoration-none rounded-4 text-center"
                               t-on-click.prevent="() => this.onDashboardAppClick(app)">
                                <div class="ef-app-card-icon-wrap d-flex align-items-center justify-content-center rounded-4 mb-2">
                                    <img t-if="app.webIconData" t-attf-src="{{app.webIconData}}" class="ef-app-card-icon" />
                                    <i t-else="" class="oi oi-apps fs-2 text-white"/>
                                </div>
                                <span class="ef-app-card-title fw-semibold text-truncate w-100 px-1 text-white"><t t-out="app.name"/></span>
                            </a>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </t>

    <!-- Recursive Submenu Tree Template -->
    <t t-name="wm_base.SidebarMenuTree">
        <t t-foreach="menuItems" t-as="menuItem" t-key="menuItem.id">
            <t t-if="!menuItem.childrenTree || !menuItem.childrenTree.length">
                <div class="nav-item mb-1">
                    <a t-att-href="this.getMenuItemHref(menuItem)"
                       class="ef-app-link ef-submenu-link d-flex align-items-center w-100 text-decoration-none rounded-3 py-1 px-2"
                       t-att-title="menuItem.name"
                       t-on-click.prevent="() => this.onSidebarMenuClick(menuItem)">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="me-2 flex-shrink-0">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                        <span class="ef-sidebar-app-name text-truncate fw-medium" style="font-size: 12.5px;"><t t-out="menuItem.name"/></span>
                    </a>
                </div>
            </t>
            <t t-else="">
                <div class="ef-sidebar-group mb-1 ps-1">
                    <div class="ef-sidebar-group-title text-uppercase fw-bold px-2 py-1" style="font-size: 10.5px; letter-spacing: 0.5px; color: #6B7280;">
                        <t t-out="menuItem.name"/>
                    </div>
                    <t t-call="wm_base.SidebarMenuTree" menuItems="menuItem.childrenTree"/>
                </div>
            </t>
        </t>
    </t>
</templates>
