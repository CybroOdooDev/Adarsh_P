<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- ═══════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════ -->
    <record id="action_media_asset" model="ir.actions.act_window">
        <field name="name">Media Assets</field>
        <field name="res_model">media.asset</field>
        <field name="view_mode">kanban,list,form</field>
       <!-- <field name="search_view_id" ref="view_media_asset_search"/> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload your first media asset!
            </p>
            <p>
                Store images, videos, documents, audio files and external URLs
                in one centralised repository.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_media_asset_form" model="ir.ui.view">
        <field name="name">media.asset.form</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <form string="Media Asset">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button type="object" name="confirm" string="Confirm" class="btn btn-primary" invisible="state in 'confirmed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Media Name…" readonly="state in 'confirmed'"/>
                        </h1>
                    </div>

                    <group>
                        <group string="General Information">
                            <field name="media_type" readonly="state in 'confirmed'"/>
                            <field name="category_id" readonly="state in 'confirmed'"/>
                            <field name="source_type" readonly="state in 'confirmed'"/>
                        </group>
                         <group string="Upload Info" >
                            <field name="create_uid" readonly="state in 'confirmed'"/>
                            <field name="create_date" readonly="state in 'confirmed'"/>
                             <field name="favorite" readonly="state in 'confirmed'"/>
                        </group>

                    </group>

                    <group string="Upload" >
                        <field name="file" filename="file_name" widget="binary" invisible="source_type =='url' or not source_type" readonly="state in 'confirmed'"/>
                        <field name="source_url" widget="url" placeholder="https://…" invisible="source_type =='file' or not source_type " readonly="state in 'confirmed'"/>
                        <field name="file_name" invisible="source_type =='url' or not source_type" readonly="state in 'confirmed'"/>
                        <field name="file_size" invisible="source_type =='url' or not source_type" readonly="state in 'confirmed'"/>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1" placeholder="Enter a description…" readonly="state in 'confirmed'"/>
                    </group>
                </sheet>
               <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_media_asset_list" model="ir.ui.view">
        <field name="name">media.asset.list</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <list string="Media Assets">
                <field name="name"/>
                <field name="media_type"/>
                <field name="category_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         KANBAN VIEW
    ═══════════════════════════════════════════════════════════ -->

    <record id="view_media_asset_kanban" model="ir.ui.view">
        <field name="name">media.asset.kanban</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="media_type"/>
                <field name="category_id"/>
                <field name="state"/>
                <field name="create_uid"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_card_header">
                                <strong>
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_card_body">
                                <div>
                                    <strong>Type:</strong>
                                    <field name="media_type"/>
                                </div>

                            <div>
                                <strong>Category:</strong>
                                <field name="category_id"/>
                            </div>
                            <div>
                                <strong>State:</strong>
                                <field name="state"/>
                            </div>
                        </div>
                        <div class="o_kanban_card_footer text-muted mt-2">
                            <small>
                                Created by:
                                <field name="create_uid"/>
                            </small>
                        </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════ -->
     <record id="view_media_asset_search" model="ir.ui.view">
        <field name="name">media asset search</field>
        <field name="model">media.asset</field>
        <field name="arch" type="xml">
            <search string="Search Media Assets">
    <field name="name"/>
    <field name="category_id"/>

    <filter name="filter_image"
            string="Images"
            domain="[('media_type','=','image')]"/>

    <filter name="filter_video"
            string="Videos"
            domain="[('media_type','=','video')]"/>

                <filter name="filter_url"
        string="URL"
        domain="[('media_type','=','url')]"/>
        <filter name="filter_document" string="Documents" domain="[('media_type','=','document')]" />
                <filter name="filter_favourite"
        string="Favourites"
        domain="[('favorite','=',True)]"/>


        <filter name="media_type"
                string="Media Type"
                context="{'group_by':'media_type'}"/>

    <filter name="group_by_category"
            string="Category"
            context="{'group_by': 'category_id'}"/>

</search>
        </field>
    </record>



    <!-- ═══════════════════════════════════════════════════════════
         MENU ITEMS
    ═══════════════════════════════════════════════════════════ -->
    <menuitem id="menu_media_repository_root"
              name="Media Repository"
              sequence="10"/>

    <menuitem id="menu_media_assets"
              name="Media Assets"
              parent="menu_media_repository_root"
              action="action_media_asset"
              sequence="10"/>

</odoo>
