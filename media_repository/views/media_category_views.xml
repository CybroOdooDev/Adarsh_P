<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <!-- ═══════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_media_category_form" model="ir.ui.view">
        <field name="name">media.category.form</field>
        <field name="model">media.category</field>
        <field name="arch" type="xml">
            <form string="Media Category">
                <sheet>
                    <group>
                       <field name="name" placeholder="Media Name…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


     <!-- ═══════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_media_category_list" model="ir.ui.view">
        <field name="name">media.category.list</field>
        <field name="model">media.category</field>
        <field name="arch" type="xml">
            <list string="Media Category">
                <field name="name"/>
            </list>
        </field>
    </record>



     <!-- ═══════════════════════════════════════════════════════════
         ACTION
    ═══════════════════════════════════════════════════════════ -->
    <record id="action_media_category" model="ir.actions.act_window">
        <field name="name">Media Category</field>
        <field name="res_model">media.category</field>
        <field name="view_mode">list,form</field>

    </record>



     <menuitem id="menu_media_category"
              name="Media Category"
              parent="menu_media_repository_root"
              action="action_media_category"
              sequence="11"/>
</odoo>





