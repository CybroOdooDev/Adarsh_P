<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wm_portal_service_request_form_inherit_wm_subscription" model="ir.ui.view">
        <field name="name">wm.portal.service.request.form.inherit.wm_subscription</field>
        <field name="model">wm.portal.service.request</field>
        <field name="inherit_id" ref="wm_contracts_billing.view_wm_portal_service_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Subscriber Pricing &amp; Benefit Breakdown">
                    <group string="Subscription Details">
                        <field name="active_subscription_id" readonly="1"/>
                        <field name="priority_sla_level" readonly="1"/>
                        <field name="is_free_swap" readonly="1" invisible="request_type != 'container_swap'"/>
                    </group>
                    <group string="Pricing Calculation">
                        <field name="base_estimated_price" widget="monetary"/>
                        <field name="subscriber_discount_pct" readonly="1"/>
                        <field name="discount_amount" widget="monetary" readonly="1"/>
                        <field name="final_estimated_price" widget="monetary" class="fw-bold"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
