<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_process_subscriptions" model="ir.cron">
            <field name="name">Waste Management: Process Subscriptions</field>
            <field name="model_id" ref="model_wm_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
