<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_jtl_ffn" model="res.groups.privilege">
        <field name="name">JTL FFN</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <record id="group_jtl_ffn_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_jtl_ffn"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_jtl_ffn_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_jtl_ffn"/>
        <field name="implied_ids" eval="[(4, ref('group_jtl_ffn_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
