<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project Kanban View -->
    <record id="view_furnishing_project_kanban" model="ir.ui.view">
        <field name="name">furnishing.project.kanban</field>
        <field name="model">furnishing.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="property_type"/>
                <field name="total_quoted_amount"/>
                <field name="currency_id"/>
                <field name="open_snag_count"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="badge text-bg-secondary"><field name="code"/></span>
                            <span class="badge text-bg-info"><field name="property_type"/></span>
                        </div>
                        <div class="fw-bold fs-6 mb-1 text-primary">
                            <field name="name"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="oi oi-fw me-1" data-icon="person" title="Customer"/> <field name="partner_id"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <div>
                                <span class="text-muted small">Quoted: </span>
                                <strong class="text-success"><field name="total_quoted_amount" widget="monetary"/></strong>
                            </div>
                            <t t-if="record.open_snag_count.raw_value > 0">
                                <span class="badge text-bg-danger" title="Open Snags">
                                    <i class="oi oi-fw me-1" data-icon="warning" title="Snags"/>
                                    <field name="open_snag_count"/> Snags
                                </span>
                            </t>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="text-muted small"><i class="oi oi-fw me-1" data-icon="badge" title="Project Manager"/> <field name="user_id"/></span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Project List View -->
    <record id="view_furnishing_project_list" model="ir.ui.view">
        <field name="name">furnishing.project.list</field>
        <field name="model">furnishing.project</field>
        <field name="arch" type="xml">
            <list string="Furnishing Projects" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="property_type"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="stage_id" widget="badge"/>
                <field name="target_completion_date"/>
                <field name="total_quoted_amount" widget="monetary" sum="Total Revenue"/>
                <field name="total_cost_amount" widget="monetary" sum="Total Cost"/>
                <field name="profit_margin" widget="monetary" sum="Total Margin"/>
                <field name="profit_margin_percentage" widget="percentage"/>
                <field name="open_snag_count" string="Open Snags"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Project Form View -->
    <record id="view_furnishing_project_form" model="ir.ui.view">
        <field name="name">furnishing.project.form</field>
        <field name="model">furnishing.project</field>
        <field name="arch" type="xml">
            <form string="Furnishing Project">
                <header>
                    <button name="action_create_survey" string="New Site Survey" type="object" class="btn-primary"/>
                    <button name="action_create_quotation" string="Create Quotation" type="object" class="btn-secondary"/>
                    <button name="action_complete_handover" string="Complete Handover &amp; Warranty" type="object" class="btn-success"
                            confirm="Are you sure you want to mark this project as completed? This will activate the warranty and DLP retention period."/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_surveys" type="object" class="oe_stat_button" icon="design_services"
                                invisible="survey_count == 0">
                            <field name="survey_count" widget="statinfo" string="Surveys"/>
                        </button>
                        <button name="action_view_submittals" type="object" class="oe_stat_button" icon="palette"
                                invisible="submittal_count == 0">
                            <field name="submittal_count" widget="statinfo" string="Submittals"/>
                        </button>
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="edit_square"
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sale Orders"/>
                        </button>
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="credit_card"
                                invisible="purchase_order_count == 0">
                            <field name="purchase_order_count" widget="statinfo" string="Purchases"/>
                        </button>
                        <button name="action_view_snags" type="object" class="oe_stat_button" icon="warning"
                                invisible="snag_count == 0">
                            <field name="snag_count" widget="statinfo" string="Snags"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="build"
                                invisible="maintenance_count == 0">
                            <field name="maintenance_count" widget="statinfo" string="Service"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="code"/></span>
                        <h1>
                            <field name="name" placeholder="Project Title (e.g. Palm Jumeirah Villa 42 Fit-Out)"/>
                        </h1>
                    </div>
                    <group>
                        <group name="customer_info">
                            <field name="partner_id" widget="res_partner_many2one" context="{'show_address': 1}"/>
                            <field name="property_type"/>
                            <field name="site_address" placeholder="Villa/Unit number, Street, Community/City..."/>
                        </group>
                        <group name="team_info">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="surveyor_id" widget="many2one_avatar_user"/>
                            <field name="designer_id" widget="many2one_avatar_user"/>
                            <field name="target_completion_date"/>
                            <field name="actual_handover_date" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Site Readiness Gate" name="site_readiness">
                            <group string="Pre-Installation Environmental Checkpoints">
                                <group>
                                    <field name="site_ac_operational"/>
                                    <field name="site_civil_completed"/>
                                </group>
                                <group>
                                    <field name="site_cleaning_done"/>
                                    <field name="site_access_approved"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Notice:</strong> For wood parquet, carpet tiles, and delicate fabrics, AC must be operational for at least 48 hours prior to delivery to prevent material acclimation failure and moisture damage.
                            </div>
                        </page>

                        <page string="Financials &amp; Profitability" name="financials">
                            <group>
                                <group string="Budget &amp; Revenue">
                                    <field name="estimated_budget" widget="monetary"/>
                                    <field name="total_quoted_amount" widget="monetary"/>
                                </group>
                                <group string="Cost &amp; Profit Margins">
                                    <field name="total_cost_amount" widget="monetary"/>
                                    <field name="profit_margin" widget="monetary"/>
                                    <field name="profit_margin_percentage" widget="percentage"/>
                                </group>
                            </group>
                        </page>

                        <page string="Warranty &amp; Retention (DLP)" name="warranty">
                            <group>
                                <group string="Warranty &amp; DLP Status">
                                    <field name="has_warranty" widget="boolean_toggle"/>
                                    <field name="warranty_start_date" invisible="not has_warranty"/>
                                    <field name="warranty_end_date" invisible="not has_warranty"/>
                                </group>
                                <group string="Retention Money (Defects Liability Period)" invisible="not has_warranty">
                                    <field name="retention_amount" widget="monetary"/>
                                    <field name="retention_release_date"/>
                                </group>
                            </group>
                            <field name="warranty_notes" placeholder="Specify warranty coverage (e.g. 1 year comprehensive guarantee on joinery and curtain motor mechanisms)..." invisible="not has_warranty"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Project Search View -->
    <record id="view_furnishing_project_search" model="ir.ui.view">
        <field name="name">furnishing.project.search</field>
        <field name="model">furnishing.project</field>
        <field name="arch" type="xml">
            <search string="Search Furnishing Projects">
                <field name="name" string="Project Title or Ref" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_id" string="Project Manager"/>
                <separator/>
                <filter name="my_projects" string="My Projects" domain="[('user_id', '=', uid)]"/>
                <filter name="open_snags" string="Has Open Snags" domain="[('snag_ids.state', 'in', ('open', 'in_progress'))]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_property_type" string="Property Type" context="{'group_by': 'property_type'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_pm" string="Project Manager" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action: All Projects -->
    <record id="action_furnishing_project" model="ir.actions.act_window">
        <field name="name">All Projects</field>
        <field name="res_model">furnishing.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_furnishing_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Surfaces Furnishing Project!
            </p>
        </field>
    </record>

    <!-- Window Action: Project Profitability Report -->
    <record id="action_furnishing_project_profitability_report" model="ir.actions.act_window">
        <field name="name">Project Profitability</field>
        <field name="res_model">furnishing.project</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_stage': 1}</field>
    </record>

</odoo>
