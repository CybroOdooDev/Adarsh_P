<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Purchase Order Form -->
    <record id="purchase_order_form_inherit_furnishing" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.furnishing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="project_id" options="{'no_create': True}"/>
                <field name="is_subcontractor"/>
                <field name="subcontractor_trade" invisible="not is_subcontractor"/>
            </xpath>
        </field>
    </record>

    <!-- Subcontractor Orders Action -->
    <record id="action_furnishing_subcontractor_orders" model="ir.actions.act_window">
        <field name="name">Subcontractor Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_subcontractor', '=', True)]</field>
        <field name="context">{'default_is_subcontractor': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage your outsourced trades (curtain stitching, parquet polishing, automation).
            </p>
        </field>
    </record>

</odoo>
