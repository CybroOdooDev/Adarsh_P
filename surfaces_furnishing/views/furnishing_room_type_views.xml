<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_furnishing_room_type_list" model="ir.ui.view">
        <field name="name">furnishing.room.type.list</field>
        <field name="model">furnishing.room.type</field>
        <field name="arch" type="xml">
            <list string="Room / Zone Presets">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="default_waste_percentage"/>
            </list>
        </field>
    </record>

    <record id="view_furnishing_room_type_form" model="ir.ui.view">
        <field name="name">furnishing.room.type.form</field>
        <field name="model">furnishing.room.type</field>
        <field name="arch" type="xml">
            <form string="Room / Zone Preset">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="default_waste_percentage"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description and notes for this room preset..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_furnishing_room_types" model="ir.actions.act_window">
        <field name="name">Room / Zone Presets</field>
        <field name="res_model">furnishing.room.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
