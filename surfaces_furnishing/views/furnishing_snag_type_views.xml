<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_furnishing_snag_type_list" model="ir.ui.view">
        <field name="name">furnishing.snag.type.list</field>
        <field name="model">furnishing.snag.type</field>
        <field name="arch" type="xml">
            <list string="Defect / Snag Categories">
                <field name="name"/>
                <field name="category"/>
                <field name="default_trade"/>
                <field name="sla_hours"/>
            </list>
        </field>
    </record>

    <record id="view_furnishing_snag_type_form" model="ir.ui.view">
        <field name="name">furnishing.snag.type.form</field>
        <field name="model">furnishing.snag.type</field>
        <field name="arch" type="xml">
            <form string="Defect / Snag Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="default_trade"/>
                            <field name="sla_hours"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description of standard defects in this category..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_furnishing_snag_types" model="ir.actions.act_window">
        <field name="name">Snag Categories</field>
        <field name="res_model">furnishing.snag.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
