<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Submittal Kanban View -->
    <record id="view_furnishing_submittal_kanban" model="ir.ui.view">
        <field name="name">furnishing.material.submittal.kanban</field>
        <field name="model">furnishing.material.submittal</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="material_name"/>
                <field name="material_category"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="swatch_photo"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="badge text-bg-secondary"><field name="name"/></span>
                            <span class="badge text-bg-light"><field name="material_category"/></span>
                        </div>
                        <div class="text-center my-2" t-if="record.swatch_photo.raw_value">
                            <field name="swatch_photo" widget="image" class="rounded" style="max-height: 100px; max-width: 100%; object-fit: cover;"/>
                        </div>
                        <div class="fw-bold mb-1">
                            <field name="material_name"/>
                        </div>
                        <div class="text-muted small">
                            <i class="oi oi-fw me-1" data-icon="folder" title="Project"/> <field name="project_id"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Submittal List View -->
    <record id="view_furnishing_submittal_list" model="ir.ui.view">
        <field name="name">furnishing.material.submittal.list</field>
        <field name="model">furnishing.material.submittal</field>
        <field name="arch" type="xml">
            <list string="Material Submittals">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="material_name"/>
                <field name="material_category"/>
                <field name="supplier_id"/>
                <field name="is_flame_retardant" widget="boolean"/>
                <field name="approval_date"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-warning="status == 'submitted'"
                       decoration-success="status in ('approved', 'approved_comments')"
                       decoration-danger="status == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Submittal Form View -->
    <record id="view_furnishing_submittal_form" model="ir.ui.view">
        <field name="name">furnishing.material.submittal.form</field>
        <field name="model">furnishing.material.submittal</field>
        <field name="arch" type="xml">
            <form string="Material Submittal &amp; Sample Approval">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" invisible="status != 'draft'" class="btn-primary"/>
                    <button name="action_approve" string="Approve Sample" type="object" invisible="status not in ('draft', 'submitted', 'revise')" class="btn-success"/>
                    <button name="action_revise" string="Revise &amp; Resubmit" type="object" invisible="status != 'submitted'" class="btn-warning"/>
                    <button name="action_reject" string="Reject" type="object" invisible="status != 'submitted'" class="btn-danger"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="name"/></span>
                        <h1>
                            <field name="material_name" placeholder="Material Description (e.g. Royal Navy Velvet 450 GSM)"/>
                        </h1>
                    </div>
                    <group>
                        <group name="project_info">
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="room_type_id"/>
                            <field name="room_name"/>
                        </group>
                        <group name="material_specs">
                            <field name="material_category"/>
                            <field name="supplier_id"/>
                            <field name="country_of_origin"/>
                            <field name="dye_lot_batch"/>
                            <field name="is_flame_retardant"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sample &amp; Technical Specifications" name="specs">
                            <group>
                                <group string="Physical Swatch Photo">
                                    <field name="swatch_photo" widget="image" class="oe_avatar" options="{'size': [200, 200]}"/>
                                </group>
                                <group string="Technical Properties">
                                    <field name="technical_specs" placeholder="e.g. Composition: 100% Polyester FR, Rub Count: 50,000 Martindale, Width: 140cm, Weight: 420 g/m²..."/>
                                </group>
                            </group>
                        </page>
                        <page string="Consultant Sign-Off &amp; Approvals" name="signoff">
                            <group>
                                <group>
                                    <field name="consultant_name"/>
                                    <field name="approval_date"/>
                                </group>
                                <group>
                                    <field name="consultant_signature" widget="signature"/>
                                </group>
                            </group>
                            <field name="comments" placeholder="Consultant approval remarks or required revisions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Submittal Search View -->
    <record id="view_furnishing_submittal_search" model="ir.ui.view">
        <field name="name">furnishing.material.submittal.search</field>
        <field name="model">furnishing.material.submittal</field>
        <field name="arch" type="xml">
            <search string="Search Material Submittals">
                <field name="name"/>
                <field name="material_name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter name="approved" string="Approved" domain="[('status', 'in', ('approved', 'approved_comments'))]"/>
                <filter name="pending" string="Pending Approval" domain="[('status', '=', 'submitted')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'material_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_furnishing_material_submittal" model="ir.actions.act_window">
        <field name="name">Material Submittals</field>
        <field name="res_model">furnishing.material.submittal</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_furnishing_submittal_search"/>
    </record>

</odoo>
