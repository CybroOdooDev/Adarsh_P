<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Sale Order Form -->
    <record id="view_order_form_inherit_furnishing" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.furnishing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add Project and Variation to header area -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="project_id" options="{'no_create': True}"/>
                <field name="is_variation"/>
                <field name="variation_reason" invisible="not is_variation"/>
            </xpath>

            <!-- Add Dimensions and Warranty to Order Lines -->
            <xpath expr="//field[@name='order_line']/list/column[@name='product_and_description']" position="before">
                <field name="room_type_id" optional="show"/>
                <field name="dimension_length" optional="hide"/>
                <field name="dimension_width" optional="hide"/>
                <field name="waste_percentage" optional="hide"/>
                <field name="calculated_area_sqm" optional="hide"/>
                <field name="has_warranty" widget="boolean_toggle" optional="show"/>
                <field name="warranty_duration_months" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
