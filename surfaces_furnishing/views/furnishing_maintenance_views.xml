<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Maintenance List View -->
    <record id="view_furnishing_maintenance_list" model="ir.ui.view">
        <field name="name">furnishing.maintenance.list</field>
        <field name="model">furnishing.maintenance</field>
        <field name="arch" type="xml">
            <list string="Service Requests &amp; Warranty Claims">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="product_id" optional="show"/>
                <field name="service_type"/>
                <field name="is_under_warranty" widget="boolean"/>
                <field name="request_date"/>
                <field name="technician_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'scheduled'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <!-- Maintenance Form View -->
    <record id="view_furnishing_maintenance_form" model="ir.ui.view">
        <field name="name">furnishing.maintenance.form</field>
        <field name="model">furnishing.maintenance</field>
        <field name="arch" type="xml">
            <form string="Service &amp; Warranty Ticket">
                <header>
                    <button name="action_schedule" string="Schedule Technician" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_start" string="Start Service" type="object" invisible="state != 'scheduled'" class="btn-primary"/>
                    <button name="action_resolve" string="Mark Resolved" type="object" invisible="state != 'in_progress'" class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('resolved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="name"/></span>
                        <h1>
                            <field name="project_id" placeholder="Select Project..."/>
                        </h1>
                    </div>
                    <group>
                        <group name="ticket_details">
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="product_has_warranty" invisible="not product_id"/>
                            <field name="service_type"/>
                            <field name="is_under_warranty"/>
                            <field name="request_date"/>
                        </group>
                        <group name="service_assignment">
                            <field name="technician_id" widget="many2one_avatar_user"/>
                            <field name="visit_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issue &amp; Resolution" name="issue">
                            <group>
                                <field name="issue_description" placeholder="Customer complaint or service details..."/>
                                <field name="resolution_notes" placeholder="Work done by technician to resolve..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Maintenance Search View -->
    <record id="view_furnishing_maintenance_search" model="ir.ui.view">
        <field name="name">furnishing.maintenance.search</field>
        <field name="model">furnishing.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Service Requests">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter name="warranty_claims" string="Warranty Claims" domain="[('service_type', '=', 'warranty')]"/>
                <filter name="open" string="Open Tickets" domain="[('state', 'in', ('draft', 'scheduled', 'in_progress'))]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_type" string="Service Type" context="{'group_by': 'service_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Service Requests -->
    <record id="action_furnishing_maintenance" model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">furnishing.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_furnishing_maintenance_search"/>
    </record>

    <!-- Action: Warranty & Retention Log -->
    <record id="action_furnishing_warranty_log" model="ir.actions.act_window">
        <field name="name">Warranty &amp; Retention Log</field>
        <field name="res_model">furnishing.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('service_type', '=', 'warranty')]</field>
        <field name="context">{'default_service_type': 'warranty'}</field>
    </record>

</odoo>
