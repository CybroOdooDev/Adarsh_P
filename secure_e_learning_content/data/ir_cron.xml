<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Session + log cleanup: runs every hour -->
    <record id="ir_cron_shield_session_cleanup" model="ir.cron">
        <field name="name">Slide Shield: Cleanup video sessions and logs</field>
        <field name="model_id" ref="model_shield_video_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
