<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Inject the shield config <meta> into every slide page <head>.
        The controller sets `slide_shield_meta` in the QWeb context;
        if the key is absent (non-slide pages) nothing is rendered.
    -->
    <template id="shield_meta_tag" name="Slide Shield Meta Injection"
              inherit_id="web.layout" priority="100">
        <xpath expr="//head" position="inside">
            <t t-if="slide_shield_meta">
                <meta name="slide-shield" t-att-content="slide_shield_meta"/>
            </t>
        </xpath>
    </template>

</odoo>
